# ================================================================
# AiDoktor Backend  -  .env
# Domain: AiDoktorapi.ziyrak.org  |  IP: 20.82.115.71
# ================================================================
# Production: When DEBUG=False, SECRET_KEY must be set (app will not start with default).
# Superuser: ADMIN_PHONE va ADMIN_PASSWORD env MAJBURIY (kodda default yo'q, kamida 12 belgi).

SECRET_KEY=your-very-secret-key-change-this-in-production

# Django admin superuser (create_superuser.py / manage.py ensure_superuser) — default YO'Q
ADMIN_PHONE=
ADMIN_PASSWORD=

# Faqat eski tashkilot hisoblarini determinstik parol bilan qayta hisoblash kerak bo'lsa.
# Yangi provisioning har doim tasodifiy parol beradi (CSV ga bir marta yoziladi).
# ORG_PASSWORD_SEED=
DEBUG=False
# Vergul bilan aniq domenlar (* qo‘ymang). Bo‘sh qoldirsangiz: fjsti/medora default ro‘yxati.
ALLOWED_HOSTS=fjsti.ziyrak.org,fjstiapi.ziyrak.org,localhost,127.0.0.1

# Bir vaqtda faqat bitta qurilma (boshqa qurilmada logout qilinmaguncha yangi qurilmadan login yo'q)
# ENFORCE_SINGLE_DEVICE_LOGIN=True
# Superuser uchun istisno (admin panel): SINGLE_DEVICE_LOGIN_EXEMPT_SUPERUSER=True

# USD → UZS (obuna narxlari, serializer `price_monthly_uzs`; frontend `VITE_USD_TO_UZS_RATE` bilan mos)
USD_TO_UZS_RATE=12500

# Database (SQL — serverda saqlanadi, restart dan keyin ham o'chib ketmaydi)
DB_ENGINE=django.db.backends.sqlite3
# Serverda (masalan /root/medoraai): shu pathdan foydalaning; loyiha papkasi boshqa bo'lsa pathni o'zgartiring
DB_NAME=/root/aidoktorfjsti/backend/db.sqlite3

# CORS — frontend domenlari (vergul bilan). Bo'sh qoldirsangiz settings.py dagi to'liq default ishlatiladi.
# DIQQAT: shu yerga yozsangiz — FAQAT shu ro'yxat amal qiladi (kod ichidagi default domenlar qo'shilmaydi).
# DEBUG=False bo'lganda `http://` originlar tashlab yuboriladi — production da https:// yozing.
CORS_ALLOWED_ORIGINS=https://fjsti.ziyrak.org

# HTTPS: True when Nginx serves SSL and sends X-Forwarded-Proto
SECURE_SSL_REDIRECT=True

# CSRF (ixtiyoriy): vergul bilan ajratilgan originlar; bo'sh qoldirsangiz settings dagi default ishlatiladi.
# CORS kabi: yozsangiz faqat shu ro'yxat, va DEBUG=False da `http://` originlar tashlanadi.
# CSRF_TRUSTED_ORIGINS=https://aidoktor.uz,https://api.aidoktor.uz

# ── Rate limit: ishonchli proxy soni ──────────────────────────────
# Nginx `$proxy_add_x_forwarded_for` ishlatadi — client yuborgan X-Forwarded-For OXIRIGA
# haqiqiy IP qo'shiladi, chapdagi qiymatlar SOXTA bo'lishi mumkin. Backend IP ni o'ngdan
# shu qiymatcha sanab oladi. Backend oldida nechta ISHONCHLI proxy bor: 1 = faqat nginx,
# 2 = CDN/LB + nginx. Noto'g'ri qiymat rate limit ni aylanib o'tishga yo'l ochadi.
TRUSTED_PROXY_COUNT=1

# ── JWT muddatlari ────────────────────────────────────────────────
# Access token qisqa bo'lishi shart: o'g'irlangan access token bekor qilinmaydi, faqat muddati tugaydi.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Frontend build (server-deploy.sh): API URL. Aidoktor.uz: https://api.aidoktor.uz/api
# VITE_API_BASE_URL=https://fjstiapi.ziyrak.org/api

# ── FJSTI Ziyrak AI (ichki inference) ─────────────────────────────
# Matn/konsilium — server ichida OPENAI_API_KEY orqali (brauzer ko'rmaydi)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
# OPENAI_BASE_URL=  # ixtiyoriy
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_PRO=gpt-4o

# Klinik payload shifrlash (64 hex yoki passphrase) — brauzer ↔ server
FJSTI_ZIYRAK_PAYLOAD_KEY=

# Legacy (deploy skriptlari; brauzer ishlatmaydi)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner

# AI xarajat: scale (1000+ user, default) | economy | balanced | quality
AI_COST_MODE=balanced
STATS_HISTORICAL_BASELINE=0
CONSILIUM_AGENT_LIMIT=4
# CLAUDE_USE_SONNET_DIAGNOSIS=true  # tashxis uchun deepseek-reasoner

# в”Ђв”Ђ Azure Speech (ovoz, ixtiyoriy) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
AZURE_SPEECH_KEY=YOUR_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_ENDPOINT=https://swedencentral.api.cognitive.microsoft.com/

# в”Ђв”Ђ Telegram в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_PAYMENT_GROUP_ID=YOUR_TELEGRAM_GROUP_ID
# MAJBURIY: Telegram webhook xavfsizligi (setWebhook dagi secret_token bilan bir xil).
# Bo'sh bo'lsa /telegram-webhook/ 503 qaytaradi va to'lovlarni umuman qayta ishlamaydi.
# Tasodifiy qiymat: python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# в”Ђв”Ђ Redis (ixtiyoriy) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
# PRODUCTION UCHUN QAT'IY TAVSIYA ETILADI. Bo'sh qoldirilsa cache = LocMemCache, ya'ni
# HAR BIR gunicorn worker uchun alohida: rate limit va login brute-force hisoblagichlari
# worker soniga ko'paytiriladi va restartda nolga tushadi (himoya ishonchsiz bo'ladi).
# Masalan: redis://127.0.0.1:6379/1
REDIS_URL=

AI_MODEL_DEFAULT=claude-opus-4-7

# Bitta login — faqat bitta qurilma (boshqa qurilmadan kirish bloklanadi, logoutdan keyin mumkin)
# ENFORCE_SINGLE_DEVICE_LOGIN=True
# Superuser ham cheklansin: False (default kodda). Faqat barcha qurilmalardan kirish kerak bo'lsa True qiling.
# SINGLE_DEVICE_LOGIN_EXEMPT_SUPERUSER=False
